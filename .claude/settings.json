{
  "model": "opus",
  "syncClaudeAiSkills": false,
  "enabledPlugins": {
    "vercel@synced": false,
    "engineering@synced": false,
    "superpowers@synced": false,
    "claude-code-setup@synced": false,
    "cowork-plugin-management@synced": false
  },
  "permissions": {
    "deny": [
      "mcp__Claude_Docs",
      "Skill(anthropic-skills:pptx)",
      "Skill(anthropic-skills:docx)",
      "Skill(anthropic-skills:xlsx)",
      "Skill(anthropic-skills:pdf)",
      "Skill(anthropic-skills:docs)",
      "Skill(anthropic-skills:google-workspace)",
      "Skill(anthropic-skills:built-in-browser)",
      "Skill(anthropic-skills:chrome-browser)",
      "Skill(anthropic-skills:computer-use)",
      "Skill(anthropic-skills:deep-research)",
      "Skill(anthropic-skills:morning)",
      "Skill(anthropic-skills:import-memory)",
      "Skill(anthropic-skills:skill-creator)",
      "Skill(plugin-authoring)",
      "Skill(session-start-hook)",
      "Skill(dataviz)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 && graphify hook-guard search || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 && graphify hook-guard read || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/graphify-baslat.sh\"",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 && graphify hook-guard compact || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
