{
  "model": "opus",
  "syncClaudeAiSkills": false,
  "enabledPlugins": {
    "vercel@synced": false,
    "engineering@synced": false,
    "superpowers@synced": false,
    "claude-code-setup@synced": false,
    "cowork-plugin-management@synced": false
  },
  "permissions": {
    "deny": [
      "mcp__Claude_Docs"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 && graphify hook-guard search || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 && graphify hook-guard read || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/graphify-baslat.sh\"",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 && graphify hook-guard compact || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:caveman": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:karpathy-guidelines": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:ponytail": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:test-driven-development": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:ebsoru": "off",
    "session-start-hook": "off",
    "dataviz": "off",
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "artifact-capabilities": "off",
    "claude-api": "off",
    "keybindings-help": "off",
    "plugin-authoring": "off",
    "impeccable": "off",
    "ui-ux-pro-max": "off"
  }
}
